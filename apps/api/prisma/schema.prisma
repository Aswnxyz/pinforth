// prisma-client-js emits plain JavaScript; the newer "prisma-client" generator emits TypeScript only.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum IssueType {
  BUG
  DESIGN
  CONTENT
  SUGGESTION
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  NEW
  IN_PROGRESS
  READY_FOR_VERIFICATION
  CLOSED
}

enum IssueSource {
  DASHBOARD
  WIDGET
}

enum ReviewRoundStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  // Stored trimmed and lowercased by the application.
  email           String    @unique @db.VarChar(320)
  name            String?   @db.VarChar(160)
  // Nullable so invited or OAuth-only users can exist without a password.
  passwordHash    String?   @db.VarChar(255)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  memberships         OrganizationMember[]
  sessions            Session[]
  verificationTokens  VerificationToken[]
  invitationsSent     Invitation[]         @relation("InvitationInviter")
  invitationsAccepted Invitation[]         @relation("InvitationAcceptor")
  reportedIssues      Issue[]              @relation("IssueReporter")
  reviewRoundsCreated ReviewRound[]
  guestLinksCreated   GuestAccessLink[]
}

// One row per refresh token. Rotation creates a new row in the same family;
// presenting an already-rotated token revokes the whole family.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  // SHA-256 of the opaque refresh token; the raw token is never stored.
  refreshTokenHash String    @unique @db.Char(64)
  familyId         String    @db.Uuid
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  replacedById     String?   @unique @db.Uuid
  userAgent        String?   @db.VarChar(512)
  ipAddress        String?   @db.VarChar(45)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   Session? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
}

// Single-use tokens for email verification and password reset.
model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @db.Uuid
  type      VerificationTokenType
  // SHA-256 of the token sent by email; the raw token is never stored.
  tokenHash String                @unique @db.Char(64)
  expiresAt DateTime              @db.Timestamptz(3)
  usedAt    DateTime?             @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(160)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members     OrganizationMember[]
  projects    Project[]
  invitations Invitation[]
}

// An email invite to join an organization. No User row is created until the
// invitee signs up and accepts. Status is derived: accepted / revoked /
// expired / pending. At most one pending invite per (organization, email),
// enforced in the service (Prisma can't express a partial unique index).
model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  // Stored trimmed and lowercased by the application.
  email          String           @db.VarChar(320)
  // ADMIN or MEMBER only: ownership is granted by an OWNER changing a role.
  role           OrganizationRole
  // SHA-256 of the emailed token; the raw token is never stored.
  tokenHash      String           @unique @db.Char(64)
  invitedById    String?          @db.Uuid
  expiresAt      DateTime         @db.Timestamptz(3)
  acceptedAt     DateTime?        @db.Timestamptz(3)
  acceptedById   String?          @db.Uuid
  revokedAt      DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedIssues Issue[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  name            String   @db.VarChar(180)
  slug            String   @db.VarChar(100)
  description     String?  @db.Text
  lastIssueNumber Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  environments Environment[]
  issues       Issue[]
  reviewRounds ReviewRound[]

  @@unique([organizationId, slug])
}

model Environment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @db.VarChar(100)
  url       String   @db.VarChar(2048)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  issues       Issue[]
  reviewRounds ReviewRound[]

  @@unique([projectId, slug])
}

model ReviewRound {
  id            String            @id @default(uuid()) @db.Uuid
  projectId     String            @db.Uuid
  environmentId String            @db.Uuid
  name          String            @db.VarChar(180)
  description   String?           @db.Text
  status        ReviewRoundStatus @default(ACTIVE)
  createdById   String?           @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment       @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  guestLinks  GuestAccessLink[]
  issues      Issue[]

  @@index([projectId, status])
  @@index([environmentId])
}

model GuestAccessLink {
  id            String    @id @default(uuid()) @db.Uuid
  reviewRoundId String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  reviewerName  String?   @db.VarChar(160)
  reviewerEmail String?   @db.VarChar(320)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  reviewRound  ReviewRound        @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  handoffCodes GuestHandoffCode[]
  sessions     GuestSession[]
  issues       Issue[]

  @@index([reviewRoundId])
}

model GuestHandoffCode {
  id          String    @id @default(uuid()) @db.Uuid
  guestLinkId String    @db.Uuid
  codeHash    String    @unique @db.Char(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  guestLink GuestAccessLink @relation(fields: [guestLinkId], references: [id], onDelete: Cascade)

  @@index([guestLinkId])
}

model GuestSession {
  id          String    @id @default(uuid()) @db.Uuid
  guestLinkId String    @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  guestLink GuestAccessLink @relation(fields: [guestLinkId], references: [id], onDelete: Cascade)

  @@index([guestLinkId])
}

model Issue {
  id               String        @id @default(uuid()) @db.Uuid
  projectId        String        @db.Uuid
  number           Int
  title            String        @db.VarChar(255)
  description      String?       @db.Text
  type             IssueType     @default(BUG)
  priority         IssuePriority @default(MEDIUM)
  status           IssueStatus   @default(NEW)
  source           IssueSource   @default(DASHBOARD)
  reporterId       String?       @db.Uuid
  assigneeId       String?       @db.Uuid
  environmentId    String?       @db.Uuid
  reviewRoundId    String?       @db.Uuid
  guestLinkId      String?       @db.Uuid
  guestName        String?       @db.VarChar(160)
  guestEmail       String?       @db.VarChar(320)
  clientMutationId String?       @db.VarChar(128)
  pageUrl          String?       @db.VarChar(2048)
  context          Json?         @db.JsonB
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter    User?               @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    OrganizationMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  environment Environment?        @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  reviewRound ReviewRound?        @relation(fields: [reviewRoundId], references: [id], onDelete: SetNull)
  guestLink   GuestAccessLink?    @relation(fields: [guestLinkId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([reviewRoundId])
  @@index([guestLinkId])
  @@unique([guestLinkId, clientMutationId])
}
