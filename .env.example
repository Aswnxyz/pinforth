# Local development only. Copy to .env — never commit real credentials.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=pinforth
POSTGRES_PASSWORD=pinforth_local_password
POSTGRES_DB=pinforth
POSTGRES_PORT=5432

# Must match the values above
DATABASE_URL=postgresql://pinforth:pinforth_local_password@localhost:5432/pinforth?schema=public

# API
PORT=4000
# Comma-separated origins allowed to call the API with cookies
WEB_ORIGIN=http://localhost:3000

# Auth — generate your own secret (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-generated-secret-of-32-plus-chars
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# Production only, e.g. .pinforth.com so app. and api. share cookies
# COOKIE_DOMAIN=
# Number of reverse proxies in front of the API (for correct client IPs)
# TRUST_PROXY=0

# Email — defaults send to Mailpit (pnpm mail:up, inbox at http://localhost:8025)
APP_URL=http://localhost:3000
MAIL_FROM="Pinforth <no-reply@pinforth.local>"
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# PASSWORD_RESET_TTL_MINUTES=30
# EMAIL_VERIFY_TTL_HOURS=24

# Tests use <DATABASE_URL database>_test automatically; set this only to override.
# TEST_DATABASE_URL=postgresql://pinforth:pinforth_local_password@localhost:5432/pinforth_test?schema=public
