{
  "name": "@pinforth/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "prisma generate",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:check": "node src/scripts/check-db.js",
    "test": "prisma generate && vitest run",
    "test:watch": "prisma generate && vitest"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@pinforth/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
