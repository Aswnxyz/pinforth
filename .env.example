# Local development only. Copy to .env — never commit real credentials.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=pinforth
POSTGRES_PASSWORD=pinforth_local_password
POSTGRES_DB=pinforth
POSTGRES_PORT=5432

# Must match the values above
DATABASE_URL=postgresql://pinforth:pinforth_local_password@localhost:5432/pinforth?schema=public

# API
PORT=4000
# Comma-separated origins allowed to call the API with cookies
WEB_ORIGIN=http://localhost:3000

# Tests use <DATABASE_URL database>_test automatically; set this only to override.
# TEST_DATABASE_URL=postgresql://pinforth:pinforth_local_password@localhost:5432/pinforth_test?schema=public
